<Window x:Class="VirtualPeto.Tools.GifBgRemoverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GIF Background Remover" Height="250" Width="450"
        Background="#1A1A24" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="GIF Background Remover" FontSize="20" FontWeight="Bold" Foreground="#4A90E2" Margin="0,0,0,15"/>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Selected File:" Foreground="#AAA" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,5"/>
            <TextBlock x:Name="TxtFileName" Text="No file selected" Foreground="White" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
        </StackPanel>

        <Button x:Name="BtnRemoveBackground" Grid.Row="2" Content="Remove Background &amp; Save" 
                Click="BtnRemoveBackground_Click" 
                Background="#4A90E2" Foreground="White" Padding="15,10" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
    </Grid>
</Window>