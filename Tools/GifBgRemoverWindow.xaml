<Window x:Class="VirtualPeto.Tools.GifBgRemoverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GIF Background Remover" Height="540" Width="760"
        Background="#1A1A24" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#1A1A24"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3A3A4A"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#4A90E2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2C2C3A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#252538" CornerRadius="8" Padding="14" BorderBrush="#333" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="GIF Background Remover" FontSize="20" FontWeight="Bold" Foreground="#4A90E2" Margin="0,0,0,12"/>
                <TextBlock Text="Selected File" Style="{StaticResource LabelStyle}"/>
                <TextBlock x:Name="TxtFileName" Text="No file selected" Foreground="#DDDDDD" Margin="0,0,0,12"/>

                <CheckBox x:Name="ChkAutoDetect" Content="Auto detect background color" IsChecked="False" Foreground="White" Margin="0,0,0,12"/>

                <TextBlock Text="Fuzz Percentage (0-100)" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="TxtFuzzPercent" Text="10" Style="{StaticResource InputTextBoxStyle}"/>

                <TextBlock Text="Manual Colors" Style="{StaticResource LabelStyle}"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button x:Name="BtnAddColor" Content="Pick Color" Click="BtnAddColor_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                    <Button x:Name="BtnRemoveColor" Content="Remove Selected" Click="BtnRemoveColor_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                    <Button x:Name="BtnClearColors" Content="Clear" Click="BtnClearColors_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                </StackPanel>

                <TextBlock x:Name="TxtPickedColor" Text="Last selected: none" Foreground="#AAAAAA" Margin="0,0,0,4"/>
                <TextBlock Text="Click on the GIF preview to sample colors." Foreground="#AAAAAA" Margin="0,0,0,8"/>
                <ListBox x:Name="LstColors" Height="200" Background="#1A1A24" Foreground="White" BorderBrush="#3A3A4A" SelectionMode="Single"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="2" Background="#252538" CornerRadius="8" Padding="14" BorderBrush="#333" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="GIF Preview" FontSize="16" FontWeight="SemiBold" Foreground="#4A90E2" Margin="0,0,0,10"/>
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Background="#1A1A24" BorderBrush="#3A3A4A" BorderThickness="1" CornerRadius="6">
                        <Grid>
                            <Image x:Name="ImgOriginalPreview" Stretch="Uniform" Cursor="Cross" MouseLeftButtonDown="ImgPreview_MouseLeftButtonDown"/>
                            <TextBlock Text="Original"
                                       Foreground="#D0D0D0"
                                       FontWeight="SemiBold"
                                       Margin="8,6,0,0"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"/>
                        </Grid>
                    </Border>
                    <Border Grid.Row="2" Background="#1A1A24" BorderBrush="#3A3A4A" BorderThickness="1" CornerRadius="6">
                        <Grid>
                            <Image x:Name="ImgProcessedPreview" Stretch="Uniform"/>
                            <TextBlock Text="Processed"
                                       Foreground="#D0D0D0"
                                       FontWeight="SemiBold"
                                       Margin="8,6,0,0"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"/>
                            <TextBlock x:Name="TxtPreviewHint"
                                       Text="Preview unavailable."
                                       Foreground="#808090"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontStyle="Italic"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                </Grid>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="BtnRemoveBackground"
                            Content="Remove"
                            Click="BtnRemoveBackground_Click"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0,0,8,0"/>
                    <Button x:Name="BtnUndoPreview"
                            Content="Undo"
                            Click="BtnUndoPreview_Click"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,8,0"
                            IsEnabled="False"/>
                    <Button x:Name="BtnSaveResult"
                            Content="Save"
                            Click="BtnSaveResult_Click"
                            Style="{StaticResource SecondaryButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>