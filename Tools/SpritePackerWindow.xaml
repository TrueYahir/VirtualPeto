<Window x:Class="VirtualPeto.Tools.SpritePackerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sprite Packer" Height="700" Width="1000"
        Background="#1A1A24" Foreground="White" WindowStartupLocation="CenterOwner">
    
    <Window.Resources>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#1E1E28"/>
            <Setter Property="Foreground" Value="#3A3A4A"/>
            <Setter Property="BorderBrush" Value="#2C2C3A"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button x:Name="BtnAddSprites" Content="Add Sprites" Click="BtnAddSprites_Click" 
                        Height="35" Width="120" Background="#4A90E2" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Margin="0,0,15,0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
                
                <Button x:Name="BtnClearSprites" Content="Clear" Click="BtnClearSprites_Click" 
                        Height="35" Width="80" Background="#2C2C3A" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Margin="0,0,15,0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
                
                <TextBlock x:Name="TxtStatus" Text="0 sprites added. Ctrl + MouseWheel to zoom." VerticalAlignment="Center" Foreground="#AAA"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="#1E1E28" BorderBrush="#2C2C3A" BorderThickness="1" CornerRadius="4" ClipToBounds="True" Margin="0,0,0,15">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                <Grid Margin="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.LayoutTransform>
                        <ScaleTransform x:Name="stZoom" ScaleX="1" ScaleY="1"/>
                    </Grid.LayoutTransform>
                    <Image x:Name="ImgPreview" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                </Grid>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnExportSheet" Content="Export Packed Sheet" Click="BtnExportSheet_Click" 
                    Height="35" Width="160" Background="#4A90E2" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>