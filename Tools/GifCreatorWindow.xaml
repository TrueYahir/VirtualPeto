<Window x:Class="VirtualPeto.Tools.GifCreatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GIF Creator" Height="560" Width="900"
        Background="#1A1A24" WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#252538" CornerRadius="8" Padding="16" BorderBrush="#333" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Create GIF from Images" FontSize="20" FontWeight="Bold" Foreground="#4A90E2" Margin="0,0,0,14"/>

                <Button x:Name="BtnSelectImages" Content="Select Images" Click="BtnSelectImages_Click"
                        Background="#2C2C3A" Foreground="White" Padding="12,8" Margin="0,0,0,10" BorderThickness="0" Cursor="Hand"/>
                <TextBlock x:Name="TxtImageCount" Text="0 images selected" Foreground="#AAAAAA" Margin="0,0,0,14"/>

                <TextBlock Text="Width" Foreground="White" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtWidth" Text="256" Margin="0,0,0,10" Padding="8,4" Background="#1A1A24" Foreground="White" BorderBrush="#3A3A4A" TextChanged="Settings_TextChanged"/>

                <TextBlock Text="Height" Foreground="White" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtHeight" Text="256" Margin="0,0,0,10" Padding="8,4" Background="#1A1A24" Foreground="White" BorderBrush="#3A3A4A" TextChanged="Settings_TextChanged"/>

                <TextBlock Text="Frame Count (max)" Foreground="White" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtFrameCount" Text="24" Margin="0,0,0,10" Padding="8,4" Background="#1A1A24" Foreground="White" BorderBrush="#3A3A4A" TextChanged="Settings_TextChanged"/>

                <TextBlock Text="Frame Delay (ms)" Foreground="White" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtDelayMs" Text="100" Margin="0,0,0,16" Padding="8,4" Background="#1A1A24" Foreground="White" BorderBrush="#3A3A4A" TextChanged="Settings_TextChanged"/>

                <Button x:Name="BtnCreateGif" Content="Create GIF" Click="BtnCreateGif_Click"
                        Background="#4A90E2" Foreground="White" Padding="12,10" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="2" Background="#252538" CornerRadius="8" Padding="16" BorderBrush="#333" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Preview" FontSize="16" FontWeight="SemiBold" Foreground="#4A90E2" Margin="0,0,0,10"/>
                <Border Grid.Row="1" Background="#1A1A24" CornerRadius="6" BorderBrush="#3A3A4A" BorderThickness="1">
                    <Grid>
                        <Image x:Name="ImgPreview" Stretch="Uniform"/>
                        <TextBlock x:Name="TxtPreviewHint"
                                   Text="Select images to preview."
                                   Foreground="#808090"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontStyle="Italic"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>