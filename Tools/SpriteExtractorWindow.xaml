<Window x:Class="VirtualPeto.Tools.SpriteExtractorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sprite Extractor" Height="560" Width="900"
        Background="#1E1E24" Foreground="White"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#252538" CornerRadius="8" Padding="16" BorderBrush="#333" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Create GIF from Sprite Sheet" FontSize="20" FontWeight="Bold" Foreground="#4A90E2" Margin="0,0,0,14"/>

                <Button Content="Select Sprite Sheet"
                        Click="BtnSelectSprite_Click"
                        Padding="12,8" Margin="0,0,0,10"
                        Background="#2C2C3A" Foreground="White" BorderThickness="0"/>

                <TextBlock x:Name="TxtSelectedSprite"
                           Text="No file selected"
                           Foreground="#AAAAAA"
                           Margin="0,0,0,14"
                           TextWrapping="Wrap"/>

                <TextBlock Text="Columns" Foreground="White" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtSpriteColumns" Text="1" Margin="0,0,0,10" Padding="8,4" Background="#1A1A24" Foreground="White" BorderBrush="#3A3A4A" TextChanged="Settings_TextChanged"/>

                <TextBlock Text="Rows" Foreground="White" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtSpriteRows" Text="1" Margin="0,0,0,10" Padding="8,4" Background="#1A1A24" Foreground="White" BorderBrush="#3A3A4A" TextChanged="Settings_TextChanged"/>

                <TextBlock Text="Width" Foreground="White" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtOutputWidth" Text="256" Margin="0,0,0,10" Padding="8,4" Background="#1A1A24" Foreground="White" BorderBrush="#3A3A4A" TextChanged="Settings_TextChanged"/>

                <TextBlock Text="Height" Foreground="White" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtOutputHeight" Text="256" Margin="0,0,0,10" Padding="8,4" Background="#1A1A24" Foreground="White" BorderBrush="#3A3A4A" TextChanged="Settings_TextChanged"/>

                <TextBlock Text="Frame Count (max)" Foreground="White" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtFrameCount" Text="24" Margin="0,0,0,10" Padding="8,4" Background="#1A1A24" Foreground="White" BorderBrush="#3A3A4A" TextChanged="Settings_TextChanged"/>

                <TextBlock Text="Frame Delay (ms)" Foreground="White" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtDelayMs" Text="100" Margin="0,0,0,16" Padding="8,4" Background="#1A1A24" Foreground="White" BorderBrush="#3A3A4A" TextChanged="Settings_TextChanged"/>

                <Button Content="Create GIF"
                        Click="BtnExtractSprites_Click"
                        Background="#4A90E2"
                        Foreground="White"
                        FontWeight="Bold"
                        Padding="12,10"
                        BorderThickness="0"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="2" Background="#252538" CornerRadius="8" Padding="16" BorderBrush="#333" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Preview" FontSize="16" FontWeight="SemiBold" Foreground="#4A90E2" Margin="0,0,0,10"/>
                <Border Grid.Row="1" Background="#1A1A24" CornerRadius="6" BorderBrush="#3A3A4A" BorderThickness="1">
                    <Grid>
                        <Image x:Name="ImgPreview" Stretch="Uniform"/>
                        <TextBlock x:Name="TxtPreviewHint"
                                   Text="Select a sprite sheet to preview."
                                   Foreground="#808090"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontStyle="Italic"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>