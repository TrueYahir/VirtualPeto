<Window x:Class="VirtualPeto.Tools.FrameExtractorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Frame Extractor" Height="420" Width="750"
        Background="#1E1E2A" Foreground="White"
        WindowStartupLocation="CenterScreen">
    
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="250"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Input GIF:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox x:Name="TxtInputFile" Grid.Column="1" Height="28" Margin="0,0,10,0" 
                         Background="#252538" Foreground="White" BorderBrush="#444" Padding="5,4" IsReadOnly="True"/>
                <Button x:Name="BtnBrowseInput" Content="Browse..." Grid.Column="2" Height="28" 
                        Background="#4A90E2" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnBrowseInput_Click"/>
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Output Folder:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox x:Name="TxtOutputFolder" Grid.Column="1" Height="28" Margin="0,0,10,0" 
                         Background="#252538" Foreground="White" BorderBrush="#444" Padding="5,4"/>
                <Button x:Name="BtnBrowseOutput" Content="Browse..." Grid.Column="2" Height="28" 
                        Background="#4A90E2" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnBrowseOutput_Click"/>
            </Grid>

            <StackPanel Grid.Row="2" Margin="0,0,0,15">
                <TextBlock Text="Extraction Mode:" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <CheckBox x:Name="ChkIndividualFrames" Content="Save as individual frames" Foreground="White" Margin="0,0,0,5" IsChecked="True"/>
                <CheckBox x:Name="ChkSpriteSheet" Content="Generate Sprite Sheet" Foreground="White" Checked="ChkSpriteSheet_Checked" Unchecked="ChkSpriteSheet_Unchecked"/>
            </StackPanel>

            <StackPanel x:Name="PanelSpriteSettings" Grid.Row="3" Margin="0,0,0,20" IsEnabled="False" Opacity="0.5">
                <TextBlock Text="Sprite Sheet Settings:" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Cols:" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="SemiBold"/>
                    <TextBox x:Name="TxtColumns" Width="40" Text="5" Background="#252538" Foreground="White" CaretBrush="White" BorderBrush="#444" Padding="2,2" Margin="0,0,15,0" TextAlignment="Center"/>
                    
                    <TextBlock Text="Width:" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="SemiBold"/>
                    <TextBox x:Name="TxtFrameWidth" Width="45" Text="64" Background="#252538" Foreground="White" CaretBrush="White" BorderBrush="#444" Padding="2,2" Margin="0,0,15,0" TextAlignment="Center"/>
                    
                    <TextBlock Text="Height:" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="SemiBold"/>
                    <TextBox x:Name="TxtFrameHeight" Width="45" Text="64" Background="#252538" Foreground="White" CaretBrush="White" BorderBrush="#444" Padding="2,2" TextAlignment="Center"/>
                </WrapPanel>
            </StackPanel>

            <Button x:Name="BtnExtract" Content="Start Extraction" Grid.Row="4" 
                    Width="180" Height="40" Background="#4A90E2" Foreground="White" BorderThickness="0" 
                    FontWeight="Bold" Cursor="Hand" Click="BtnExtract_Click" VerticalAlignment="Bottom" HorizontalAlignment="Left"/>
        </Grid>

        <Border Grid.Column="2" Background="#181822" BorderBrush="#444" BorderThickness="1" CornerRadius="5">
            <Image x:Name="ImgPreview" Stretch="Uniform" Margin="5"/>
        </Border>
    </Grid>
</Window>