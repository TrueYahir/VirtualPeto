<local:PetWindowBase x:Class="VirtualPeto.SmartPetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VirtualPeto"
        Title="SmartPetWindow" Height="150" Width="150">
    
    <local:PetWindowBase.Resources>
    </local:PetWindowBase.Resources>

    <local:PetWindowBase.ContextMenu>
        <ContextMenu x:Name="PetContextMenu" Opened="PetContextMenu_Opened">
            
            <MenuItem Header="Close Pet" Click="MenuClosePet_Click">
                <MenuItem.Icon>
                    <Image Source="pack://application:,,,/Assets/Buttons/btn_close.png" Width="14" Height="14" Stretch="Uniform" Opacity="0.8"/>
                </MenuItem.Icon>
            </MenuItem>
            
            <MenuItem x:Name="MenuPinPet" Header="Pin Pet" Click="MenuPinPet_Click">
                <MenuItem.Icon>
                    <Image Source="pack://application:,,,/Assets/Buttons/btn_pin.png" Width="14" Height="14" Stretch="Uniform" Opacity="0.8"/>
                </MenuItem.Icon>
            </MenuItem>
            
            <MenuItem x:Name="MenuFollowMouse" Header="Follow Mouse" Click="MenuFollowMouse_Click">
                <MenuItem.Icon>
                    <Image Source="pack://application:,,,/Assets/Buttons/btn_cursor.png" Width="14" Height="14" Stretch="Uniform" Opacity="0.8"/>
                </MenuItem.Icon>
            </MenuItem>
            
            <MenuItem Height="1" Margin="30,4,10,4" IsEnabled="False">
                <MenuItem.Template>
                    <ControlTemplate TargetType="MenuItem">
                        <Rectangle Fill="#3A3A4A"/>
                    </ControlTemplate>
                </MenuItem.Template>
            </MenuItem>
            
            <MenuItem Header="Generate Food" Click="MenuGenerateFood_Click">
                <MenuItem.Icon>
                    <Image Source="pack://application:,,,/Assets/Buttons/btn_food.png" Width="14" Height="14" Stretch="Uniform" Opacity="0.8"/>
                </MenuItem.Icon>
            </MenuItem>
            
            <MenuItem Header="Generate Toy" Click="MenuGenerateToy_Click">
                <MenuItem.Icon>
                    <Image Source="pack://application:,,,/Assets/Buttons/btn_game.png" Width="14" Height="14" Stretch="Uniform" Opacity="0.8"/>
                </MenuItem.Icon>
            </MenuItem>
            
            <MenuItem Header="Generate Jukebox" Click="MenuGenerateJukebox_Click">
                <MenuItem.Icon>
                    <TextBlock Text="🎵" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </MenuItem.Icon>
            </MenuItem>
            
        </ContextMenu>
    </local:PetWindowBase.ContextMenu>

    <Grid>
        <Image x:Name="PetSprite" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
    </Grid>
</local:PetWindowBase>