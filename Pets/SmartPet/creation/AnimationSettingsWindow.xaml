<Window x:Class="VirtualPeto.AnimationSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Animation Settings" Height="420" Width="650"
        WindowStartupLocation="CenterOwner" Background="#1A1A24" Foreground="White" ResizeMode="NoResize">
    
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
            <CheckBox x:Name="ChkIsSprite" Content="Use custom dimensions (Sprite Sheet)" Foreground="White" Margin="0,0,0,15"/>
            
            <UniformGrid Columns="2" Margin="0,0,0,10">
                <StackPanel Margin="0,0,5,0">
                    <TextBlock Text="Frame Width:" Foreground="#DDD" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtWidth" Background="#252538" Foreground="White" CaretBrush="White" Padding="4"/>
                </StackPanel>
                <StackPanel Margin="5,0,0,0">
                    <TextBlock Text="Frame Height:" Foreground="#DDD" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtHeight" Background="#252538" Foreground="White" CaretBrush="White" Padding="4"/>
                </StackPanel>
            </UniformGrid>
            
            <UniformGrid Columns="2" Margin="0,0,0,10">
                <StackPanel Margin="0,0,5,0">
                    <TextBlock Text="Columns:" Foreground="#DDD" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtCols" Background="#252538" Foreground="White" CaretBrush="White" Padding="4"/>
                </StackPanel>
                <StackPanel Margin="5,0,0,0">
                    <TextBlock Text="Rows:" Foreground="#DDD" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtRows" Background="#252538" Foreground="White" CaretBrush="White" Padding="4"/>
                </StackPanel>
            </UniformGrid>

            <UniformGrid Columns="2" Margin="0,0,0,15">
                <StackPanel Margin="0,0,5,0">
                    <TextBlock Text="Total Frames:" Foreground="#DDD" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtFrames" Background="#252538" Foreground="White" CaretBrush="White" Padding="4"/>
                </StackPanel>
                <StackPanel Margin="5,0,0,0">
                    <TextBlock Text="FPS:" Foreground="#DDD" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtFps" Background="#252538" Foreground="White" CaretBrush="White" Padding="4"/>
                </StackPanel>
            </UniformGrid>

            <TextBlock Text="Audio File:" Foreground="#DDD" Margin="0,0,0,4"/>
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtAudio" Background="#252538" Foreground="White" CaretBrush="White" Padding="4" IsReadOnly="True" Margin="0,0,5,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Browse" Click="BtnBrowseAudio_Click" Background="#4A90E2" Foreground="White" Padding="10,0" BorderThickness="0" Margin="0,0,5,0"/>
                    <Button Content="Clear" Click="BtnClearAudio_Click" Background="#E24A4A" Foreground="White" Padding="10,0" BorderThickness="0"/>
                </StackPanel>
            </Grid>

            <UniformGrid Columns="2">
                <Button Content="Save" Click="BtnSave_Click" Background="#4A90E2" Foreground="White" Height="30" Margin="0,0,5,0" BorderThickness="0"/>
                <Button Content="Cancel" Click="BtnCancel_Click" Background="#E24A4A" Foreground="White" Height="30" Margin="5,0,0,0" BorderThickness="0"/>
            </UniformGrid>
        </StackPanel>

        <StackPanel Grid.Column="2">
            <TextBlock Text="Live Preview" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
            <Border Background="#12121A" CornerRadius="8" Padding="10" MinHeight="300" BorderBrush="#252538" BorderThickness="1">
                <Image x:Name="ImgPreview" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
        </StackPanel>
    </Grid>
</Window>