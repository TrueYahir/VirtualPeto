<Window x:Class="VirtualPeto.ConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gif="clr-namespace:WpfAnimatedGif;assembly=WpfAnimatedGif"
        Title="VirtualPeto" Height="600" Width="950"
        MinWidth="800" MinHeight="550"
        Icon="/Assets/icon.ico"
        Background="#0F0F14" Foreground="White" WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <DataTemplate x:Key="LibraryListTemplate">
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="30"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="video" Visibility="{Binding VideoIconVisibility}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <Image Grid.Column="0" Source="{Binding Thumbnail}" Width="40" Height="40" Visibility="{Binding ImageIconVisibility}" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center" Foreground="White" TextTrimming="CharacterEllipsis" Margin="10,0,10,0"/>
                <TextBlock Grid.Column="2" Text="{Binding FileType}" VerticalAlignment="Center" Foreground="#A0A0A0" FontWeight="Bold" Margin="0,0,10,0"/>
                <Ellipse Grid.Column="3" Width="10" Height="10" Fill="Lime" Margin="0,0,0,0" Visibility="{Binding VisibilityIndicator}" VerticalAlignment="Center"/>

                <ToggleButton Grid.Column="4" IsChecked="{Binding IsFavorite, Mode=TwoWay}" Click="FavoriteToggle_Click" Cursor="Hand" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <TextBlock Text="★" Foreground="{TemplateBinding Foreground}" FontSize="20" VerticalAlignment="Center"/>
                        </ControlTemplate>
                    </ToggleButton.Template>
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Foreground" Value="Gray"/>
                            <Style.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Foreground" Value="Gold"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="LibraryGridTemplate">
            <Border Width="150" Margin="6" Background="#222" CornerRadius="10" Padding="8">
                <StackPanel>
                    <Image Source="{Binding Thumbnail}" Width="130" Height="130" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="White" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <Ellipse Grid.Column="1" Width="12" Height="12" Fill="Lime" Visibility="{Binding VisibilityIndicator}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        
                        <ToggleButton Grid.Column="2" IsChecked="{Binding IsFavorite, Mode=TwoWay}" Click="FavoriteToggle_Click" Cursor="Hand" Background="Transparent" BorderThickness="0">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <TextBlock Text="★" Foreground="{TemplateBinding Foreground}" FontSize="18" VerticalAlignment="Center"/>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Foreground" Value="Gray"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="Foreground" Value="Gold"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="LibraryListItemsPanel">
            <VirtualizingStackPanel/>
        </ItemsPanelTemplate>

        <ItemsPanelTemplate x:Key="LibraryGridItemsPanel">
            <WrapPanel Orientation="Horizontal" ItemWidth="170" MinWidth="170"/>
        </ItemsPanelTemplate>

        <DataTemplate x:Key="PetListTemplate">
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" Source="{Binding Thumbnail}" Width="40" Height="40" Margin="0,0,10,0"/>
                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" Foreground="White" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                <Ellipse Grid.Column="2" Width="10" Height="10" Fill="Lime" Margin="0,0,10,0" Visibility="{Binding VisibilityIndicator}" VerticalAlignment="Center"/>
                <ToggleButton Grid.Column="3" IsChecked="{Binding IsFavorite, Mode=TwoWay}" Click="FavoriteToggle_Click" Cursor="Hand" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <TextBlock Text="★" Foreground="{TemplateBinding Foreground}" FontSize="20" VerticalAlignment="Center"/>
                        </ControlTemplate>
                    </ToggleButton.Template>
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Foreground" Value="Gray"/>
                            <Style.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Foreground" Value="Gold"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>
            </Grid>
        </DataTemplate>


        <DataTemplate x:Key="PetGridTemplate">
            <Border Width="160" Margin="6" Background="#1B1B22" CornerRadius="8" Padding="8">
                <StackPanel>
                    <Grid Height="110">
                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="White" FontWeight="Bold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        
                        <Ellipse Grid.Column="1" Width="12" Height="12" Fill="Lime" Visibility="{Binding VisibilityIndicator}" VerticalAlignment="Center" Margin="0,0,5,0"/>

                        <ToggleButton Grid.Column="2" IsChecked="{Binding IsFavorite, Mode=TwoWay}" Click="FavoriteToggle_Click" Cursor="Hand" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <TextBlock Text="★" Foreground="{TemplateBinding Foreground}" FontSize="18" VerticalAlignment="Center"/>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Foreground" Value="Gray"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="Foreground" Value="Gold"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="PetListItemsPanel">
            <VirtualizingStackPanel/>
        </ItemsPanelTemplate>

        <ItemsPanelTemplate x:Key="PetGridItemsPanel">
            <WrapPanel Orientation="Horizontal" ItemWidth="170" MinWidth="170"/>
        </ItemsPanelTemplate>

        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border" Padding="10,5" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent" Margin="0,0,15,10">
                            <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="White" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter Property="Foreground" Value="#888888" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <SolidColorBrush x:Key="CreatorButtonBg" Color="#252538"/>
    
        <Style TargetType="Button" x:Key="AnimatedCreatorButton">
            <Setter Property="Background" Value="{StaticResource CreatorButtonBg}"/>
            <Setter Property="Foreground" Value="#4A90E2"/>
            <Setter Property="BorderBrush" Value="#333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            
                            <TextBlock Text="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                    FontSize="20" FontWeight="Bold" Foreground="{TemplateBinding Foreground}" 
                                    TextWrapping="Wrap" TextAlignment="Center" Margin="10"/>
                        </Border>
                        
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="border" 
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" 
                                                        To="#2E2E42" Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetName="border" 
                                                        Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)" 
                                                        To="1.03" Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetName="border" 
                                                        Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)" 
                                                        To="1.03" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="border" 
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" 
                                                        To="#252538" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="border" 
                                                        Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)" 
                                                        To="1" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="border" 
                                                        Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)" 
                                                        To="1" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#4A4A5A" 
                                                        CornerRadius="4" 
                                                        Margin="1" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox" x:Key="CircularCheckBoxStyle">
            <Setter Property="Margin" Value="0,0,20,0"/> 
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1A1A24"/>
            <Setter Property="BorderBrush" Value="#333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Margin="0,0,8,0">
                                <Ellipse Width="16" Height="16" 
                                        Fill="{TemplateBinding Background}" 
                                        Stroke="{TemplateBinding BorderBrush}" 
                                        StrokeThickness="{TemplateBinding BorderThickness}"/>
                                <Ellipse x:Name="CheckMark" 
                                        Width="8" Height="8" 
                                        Fill="Lime" 
                                        Visibility="Collapsed"/>
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                <Setter Property="BorderBrush" Value="Lime"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox" x:Key="GoldCircularCheckBoxStyle">
            <Setter Property="Margin" Value="0,0,20,0"/> 
            
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1A1A24"/>
            <Setter Property="BorderBrush" Value="#333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Margin="0,0,8,0">
                                <Ellipse Width="16" Height="16" 
                                        Fill="{TemplateBinding Background}" 
                                        Stroke="{TemplateBinding BorderBrush}" 
                                        StrokeThickness="{TemplateBinding BorderThickness}"/>
                                <Ellipse x:Name="CheckMark" 
                                        Width="8" Height="8" 
                                        Fill="Gold" 
                                        Visibility="Collapsed"/>
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                <Setter Property="BorderBrush" Value="Gold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox" x:Key="DarkComboBoxStyle">
            <Setter Property="Background" Value="#1A1A24"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    CornerRadius="3"/>
                            <ToggleButton x:Name="ToggleButton" 
                                        IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                        Focusable="False" 
                                        ClickMode="Press" 
                                        Background="Transparent" 
                                        BorderThickness="0">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Grid>
                                            <Border Background="Transparent"/>
                                            <Path x:Name="Arrow" 
                                                Fill="White" 
                                                HorizontalAlignment="Right" 
                                                VerticalAlignment="Center" 
                                                Margin="0,0,10,0" 
                                                Data="M 0 0 L 4 4 L 8 0 Z"/>
                                        </Grid>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            
                            <ContentPresenter x:Name="ContentSite" 
                                            IsHitTestVisible="False" 
                                            Content="{TemplateBinding SelectionBoxItem}" 
                                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                            Margin="{TemplateBinding Padding}" 
                                            VerticalAlignment="Center" 
                                            HorizontalAlignment="Left" />
                            <Popup x:Name="Popup" 
                                Placement="Bottom" 
                                IsOpen="{TemplateBinding IsDropDownOpen}" 
                                AllowsTransparency="True" 
                                Focusable="False" 
                                PopupAnimation="Slide">
                                <Grid x:Name="DropDown" 
                                    SnapsToDevicePixels="True" 
                                    MinWidth="{TemplateBinding ActualWidth}" 
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" 
                                            Background="#252538" 
                                            BorderThickness="1" 
                                            BorderBrush="#333"/>
                                    <ScrollViewer Margin="1" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para los elementos dentro de la lista (ComboBoxItem) -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#252538"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Border" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Cambia de color al pasar el mouse -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#3D3D5C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </Window.Resources>
        <!-- RIGHT PANEL-->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TabControl Background="Transparent" BorderBrush="Transparent" Margin="10" Grid.Row="0">
                
                <TabItem Header="Library">
                    <Grid Margin="10,15,10,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Grid Grid.Column="0" Margin="0,0,15,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <TextBlock Text="Your Library" FontSize="20" FontWeight="Bold" Margin="0,0,0,15" Foreground="White"/>
                            
                            <Grid Grid.Row="1" Margin="0,0,0,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBox x:Name="TxtSearchLibrary" TextChanged="Filters_Changed" Background="#1A1A24" Foreground="White" Padding="5" BorderBrush="#333"/>
                                <Button Grid.Column="1" Content="+ Add from PC" Click="BtnAddLibrary_Click" Background="#2C2C3A" Foreground="White" Padding="10,5" Margin="10,0,0,0"/>
                                
                                <ToggleButton x:Name="BtnToggleLibraryView" Click="BtnToggleLibraryView_Click" Grid.Column="2" Width="80" Height="30" Cursor="Hand" Margin="10,0,0,0" ToolTip="Toggle View">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="#1A1A24" BorderBrush="#333" BorderThickness="1" CornerRadius="15">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border x:Name="ListBg" Grid.Column="0" Background="#35354E" CornerRadius="14,0,0,14" Margin="1"/>
                                                    <Border x:Name="GridBg" Grid.Column="1" Background="Transparent" CornerRadius="0,14,14,0" Margin="1"/>

                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" Width="16">
                                                        <Rectangle x:Name="Line1" Height="2" Fill="White" Margin="0,0,0,3"/>
                                                        <Rectangle x:Name="Line2" Height="2" Fill="White" Margin="0,0,0,3"/>
                                                        <Rectangle x:Name="Line3" Height="2" Fill="White"/>
                                                    </StackPanel>

                                                    <UniformGrid Grid.Column="1" Columns="2" Rows="2" Width="14" Height="14" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <Rectangle x:Name="Sq1" Fill="#666" Margin="0,0,2,2"/>
                                                        <Rectangle x:Name="Sq2" Fill="#666" Margin="0,0,0,2"/>
                                                        <Rectangle x:Name="Sq3" Fill="#666" Margin="0,0,2,0"/>
                                                        <Rectangle x:Name="Sq4" Fill="#666"/>
                                                    </UniformGrid>
                                                </Grid>
                                            </Border>
                                            
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="ListBg" Property="Background" Value="Transparent"/>
                                                    <Setter TargetName="GridBg" Property="Background" Value="#35354E"/>
                                                    <Setter TargetName="Line1" Property="Fill" Value="#666"/>
                                                    <Setter TargetName="Line2" Property="Fill" Value="#666"/>
                                                    <Setter TargetName="Line3" Property="Fill" Value="#666"/>
                                                    <Setter TargetName="Sq1" Property="Fill" Value="White"/>
                                                    <Setter TargetName="Sq2" Property="Fill" Value="White"/>
                                                    <Setter TargetName="Sq3" Property="Fill" Value="White"/>
                                                    <Setter TargetName="Sq4" Property="Fill" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="Filter by:" Foreground="#AAA" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    
                                    <ComboBox x:Name="CmbFilterType" 
                                            Style="{StaticResource DarkComboBoxStyle}"
                                            SelectionChanged="Filters_Changed" 
                                            Width="100" 
                                            Margin="0,0,15,0">
                                        <ComboBoxItem Content="All Types" IsSelected="True"/>
                                        <ComboBoxItem Content="Images"/>
                                        <ComboBoxItem Content="GIFs"/>
                                        <ComboBoxItem Content="Videos"/>
                                        <ComboBoxItem Content="Favorites"/>
                                        
                                    </ComboBox>
                                    <CheckBox x:Name="ChkFilterActive" Content="Only Active" Style="{StaticResource CircularCheckBoxStyle}" Checked="Filters_Changed" Unchecked="Filters_Changed"/>
                                    <CheckBox x:Name="ChkOnlyFavorites" Content="★ Favorites" Style="{StaticResource GoldCircularCheckBoxStyle}" Checked="Filters_Changed" Unchecked="Filters_Changed"/>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="2" Margin="5,10,5,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Grid.Column="1" Text="Name" Foreground="#E04343" FontWeight="Bold" Margin="10,0,10,0"/>
                                <TextBlock Grid.Column="2" Text="Type" Foreground="#E04343" FontWeight="Bold" Margin="0,0,10,0"/>
                            </Grid>

                            <ListBox x:Name="LstLibrary" Grid.Row="3" Background="#1A1A24" BorderBrush="#333" Foreground="White" SelectionChanged="LstLibrary_SelectionChanged" ItemTemplate="{StaticResource LibraryListTemplate}" ItemsPanel="{StaticResource LibraryGridItemsPanel}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="VerticalContentAlignment" Value="Top"/>
                                        <Setter Property="Padding" Value="0"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Grid>

                        <Border Grid.Column="1" Background="#1A1A24" CornerRadius="10" Padding="15">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> 
                                    <RowDefinition Height="*"/>    
                                    <RowDefinition Height="Auto"/> 
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="TxtSelectedLibraryName" Grid.Row="0" Text="None selected" FontWeight="Bold" TextAlignment="Center" Margin="0,0,0,10" Foreground="White"/>
                                <Border Grid.Row="1" Background="Black" Margin="0,0,0,15">
                                    <Grid>
                                        <TextBlock x:Name="TxtEmptyLibraryPreview" Text="No preview" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="Gray"/>
                                        <Image x:Name="ImgLibraryPreview" Stretch="Uniform"/>
                                        <MediaElement x:Name="VidLibraryPreview" Stretch="Uniform" LoadedBehavior="Manual" UnloadedBehavior="Stop" Visibility="Collapsed" IsMuted="True" MediaEnded="VidLibraryPreview_MediaEnded"/>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                                    <StackPanel x:Name="PnlSize" Visibility="Collapsed" Margin="0,0,0,15">
                                        <TextBlock x:Name="TxtSizeLabel" Text="Size (Pixels): (150x150)" Margin="0,0,0,5" Foreground="White"/>
                                        
                                        <Slider x:Name="SldSize" Minimum="50" Maximum="500" Value="150" 
                                                ValueChanged="SldSize_ValueChanged" 
                                                PreviewMouseWheel="SldSize_PreviewMouseWheel"
                                                Margin="0,5,0,15">
                                            <Slider.Template>
                                                <ControlTemplate TargetType="Slider">
                                                    <Grid Height="20">
                                                        <Border Height="2" Background="#444444" VerticalAlignment="Center" Margin="6,0"/>
                                                        
                                                        <Track Name="PART_Track">
                                                            <Track.DecreaseRepeatButton>
                                                                <RepeatButton Command="Slider.DecreaseLarge">
                                                                    <RepeatButton.Template>
                                                                        <ControlTemplate TargetType="RepeatButton">
                                                                            <Border Height="2" Background="White" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                                        </ControlTemplate>
                                                                    </RepeatButton.Template>
                                                                </RepeatButton>
                                                            </Track.DecreaseRepeatButton>
                                                            
                                                            <Track.Thumb>
                                                                <Thumb>
                                                                    <Thumb.Template>
                                                                        <ControlTemplate TargetType="Thumb">
                                                                            <Ellipse Width="12" Height="12" Fill="White" Cursor="Hand"/>
                                                                        </ControlTemplate>
                                                                    </Thumb.Template>
                                                                </Thumb>
                                                            </Track.Thumb>
                                                            
                                                            <Track.IncreaseRepeatButton>
                                                                <RepeatButton Command="Slider.IncreaseLarge">
                                                                    <RepeatButton.Template>
                                                                        <ControlTemplate TargetType="RepeatButton">
                                                                            <Border Background="Transparent"/>
                                                                        </ControlTemplate>
                                                                    </RepeatButton.Template>
                                                                </RepeatButton>
                                                            </Track.IncreaseRepeatButton>
                                                        </Track>
                                                    </Grid>
                                                </ControlTemplate>
                                            </Slider.Template>
                                        </Slider>
                                    </StackPanel>

                                    <StackPanel x:Name="PnlFps" Visibility="Collapsed" Margin="0,0,0,15">
                                        <TextBlock Text="GIF Speed (FPS):" Margin="0,0,0,8" Foreground="White" FontWeight="Bold"/>
                                        
                                        <Grid Height="28">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="40"/>
                                            </Grid.ColumnDefinitions>

                                            <Grid.Resources>
                                                <Style TargetType="Button" x:Key="DarkRoundedButton">
                                                    <Setter Property="Background" Value="#1E1E26"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="FontSize" Value="14"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Cursor" Value="Hand"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" 
                                                                        CornerRadius="4">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#2D2D38"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Resources>

                                            <Button Grid.Column="0" Content="-" Style="{StaticResource DarkRoundedButton}" 
                                                    Click="BtnDecreaseFps_Click"/>

                                            <Border Grid.Column="1" Background="#1E1E26" CornerRadius="4" Margin="5,0">
                                                <TextBox x:Name="TxtFps" Text="15" 
                                                        Background="Transparent" Foreground="White" BorderThickness="0" 
                                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                        FontWeight="Bold" IsReadOnly="True" Cursor="Arrow"/>
                                            </Border>

                                            <Button Grid.Column="2" Content="+" Style="{StaticResource DarkRoundedButton}" 
                                                    Click="BtnIncreaseFps_Click"/>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel x:Name="PnlAudio" Visibility="Collapsed" Margin="0,0,0,15">
                                        <TextBlock Text="Audio:" Margin="0,0,0,8" Foreground="#66A3FF" FontWeight="Bold"/>
                                        
                                        <Grid Height="30">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/> 
                                                <ColumnDefinition Width="Auto"/> 
                                                <ColumnDefinition Width="*"/>  
                                            </Grid.ColumnDefinitions>

                                            <Button x:Name="BtnMute" Grid.Column="0" Width="32" Height="28" Margin="0,0,10,0" Background="#1E1E26" BorderThickness="0" Cursor="Hand" Click="BtnTestLibrarySound_Click">
                                                <TextBlock Text="🔊" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Button>
                                            
                                            <TextBlock x:Name="TxtVolumeLabel" Grid.Column="1" Text="Volume: 50%" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            
                                            <Slider x:Name="SldVolume" Grid.Column="2" Minimum="0" Maximum="100" Value="50" 
                                                    VerticalAlignment="Center"
                                                    ValueChanged="SldVolume_ValueChanged" 
                                                    PreviewMouseWheel="SldVolume_PreviewMouseWheel">
                                                <Slider.Template>
                                                    <ControlTemplate TargetType="Slider">
                                                        <Grid Height="20">
                                                            <Border Height="2" Background="#444444" VerticalAlignment="Center" Margin="6,0"/>
                                                            <Track Name="PART_Track">
                                                                <Track.DecreaseRepeatButton>
                                                                    <RepeatButton Command="Slider.DecreaseLarge">
                                                                        <RepeatButton.Template>
                                                                            <ControlTemplate TargetType="RepeatButton">
                                                                                <Border Height="2" Background="White" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                                            </ControlTemplate>
                                                                        </RepeatButton.Template>
                                                                    </RepeatButton>
                                                                </Track.DecreaseRepeatButton>
                                                                <Track.Thumb>
                                                                    <Thumb>
                                                                        <Thumb.Template>
                                                                            <ControlTemplate TargetType="Thumb">
                                                                                <Ellipse Width="12" Height="12" Fill="White" Cursor="Hand"/>
                                                                            </ControlTemplate>
                                                                        </Thumb.Template>
                                                                    </Thumb>
                                                                </Track.Thumb>
                                                                <Track.IncreaseRepeatButton>
                                                                    <RepeatButton Command="Slider.IncreaseLarge">
                                                                        <RepeatButton.Template>
                                                                            <ControlTemplate TargetType="RepeatButton">
                                                                                <Border Background="Transparent"/>
                                                                            </ControlTemplate>
                                                                        </RepeatButton.Template>
                                                                    </RepeatButton>
                                                                </Track.IncreaseRepeatButton>
                                                            </Track>
                                                        </Grid>
                                                    </ControlTemplate>
                                                </Slider.Template>
                                            </Slider>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel x:Name="LibraryActionButtonsPanel" Margin="0,10,0,0" Visibility="Collapsed">
                                        <StackPanel.Resources>
                                            
                                            <Style x:Key="BaseRoundedBtn" TargetType="Button">
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Height" Value="38"/> 
                                                <Setter Property="Margin" Value="0,0,0,8"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter Property="Opacity" Value="0.8"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>

                                            <Style x:Key="BtnLaunchStyle" BasedOn="{StaticResource BaseRoundedBtn}" TargetType="Button">
                                                <Setter Property="Background" Value="#6366F1"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#818CF8"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>

                                            <Style x:Key="BtnCloseStyle" BasedOn="{StaticResource BaseRoundedBtn}" TargetType="Button">
                                                <Setter Property="Background" Value="#D97706"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#F59E0B"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>

                                            <Style x:Key="BtnDeleteStyle" BasedOn="{StaticResource BaseRoundedBtn}" TargetType="Button">
                                                <Setter Property="Background" Value="#EF4444"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#F87171"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                            
                                        </StackPanel.Resources>

                                        <Button Content="Launch Pet" 
                                                Style="{StaticResource BtnLaunchStyle}"
                                                Click="BtnLaunchLibrary_Click"/>
                                                
                                        <Button Content="Close Active Pet" 
                                                Style="{StaticResource BtnCloseStyle}"
                                                Click="BtnCloseLibrary_Click" 
                                                Visibility="{Binding SelectedItem.IsActive, ElementName=LstLibrary, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"/>
                                                
                                        <Button Content="Delete" 
                                                Style="{StaticResource BtnDeleteStyle}"
                                                Click="BtnDeleteLibrary_Click" 
                                                Margin="0"/> 
                    
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

            <TabItem Header="Smart Pets">
                <Grid Margin="10,15,10,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Grid Grid.Column="0" Margin="0,0,15,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Text="Smart Pets" FontSize="20" FontWeight="Bold" Margin="0,0,0,15" Foreground="White"/>
                        
                        <Grid Grid.Row="1" Margin="0,0,0,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBox x:Name="TxtSearchPet" TextChanged="TxtSearchPet_TextChanged" Background="#1A1A24" Foreground="White" Padding="5" BorderBrush="#333"/>
                            <Button Grid.Column="1" Content="+ Add from PC" Click="BtnAddPet_Click" Background="#2C2C3A" Foreground="White" Padding="10,5" Margin="10,0,0,0"/>
                            
                            <ToggleButton x:Name="BtnTogglePetView" Click="BtnTogglePetView_Click" Grid.Column="2" Width="80" Height="30" Cursor="Hand" Margin="10,0,0,0" ToolTip="Toggle View">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="#1A1A24" BorderBrush="#333" BorderThickness="1" CornerRadius="15">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Border x:Name="ListBg" Grid.Column="0" Background="#35354E" CornerRadius="14,0,0,14" Margin="1"/>
                                                <Border x:Name="GridBg" Grid.Column="1" Background="Transparent" CornerRadius="0,14,14,0" Margin="1"/>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" Width="16">
                                                    <Rectangle x:Name="Line1" Height="2" Fill="White" Margin="0,0,0,3"/>
                                                    <Rectangle x:Name="Line2" Height="2" Fill="White" Margin="0,0,0,3"/>
                                                    <Rectangle x:Name="Line3" Height="2" Fill="White"/>
                                                </StackPanel>

                                                <UniformGrid Grid.Column="1" Columns="2" Rows="2" Width="14" Height="14" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <Rectangle x:Name="Sq1" Fill="#666" Margin="0,0,2,2"/>
                                                    <Rectangle x:Name="Sq2" Fill="#666" Margin="0,0,0,2"/>
                                                    <Rectangle x:Name="Sq3" Fill="#666" Margin="0,0,2,0"/>
                                                    <Rectangle x:Name="Sq4" Fill="#666"/>
                                                </UniformGrid>
                                            </Grid>
                                        </Border>
                                        
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ListBg" Property="Background" Value="Transparent"/>
                                                <Setter TargetName="GridBg" Property="Background" Value="#35354E"/>
                                                <Setter TargetName="Line1" Property="Fill" Value="#666"/>
                                                <Setter TargetName="Line2" Property="Fill" Value="#666"/>
                                                <Setter TargetName="Line3" Property="Fill" Value="#666"/>
                                                <Setter TargetName="Sq1" Property="Fill" Value="White"/>
                                                <Setter TargetName="Sq2" Property="Fill" Value="White"/>
                                                <Setter TargetName="Sq3" Property="Fill" Value="White"/>
                                                <Setter TargetName="Sq4" Property="Fill" Value="White"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="Filter by:" Foreground="#AAA" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <CheckBox x:Name="ChkFilterActivePets" 
                                        Content="Only Active" 
                                        Style="{StaticResource CircularCheckBoxStyle}" 
                                        Checked="Filters_Changed" 
                                        Unchecked="Filters_Changed"/>
                                <CheckBox x:Name="ChkOnlyFavoritesPets" 
                                        Content="★ Favorites" 
                                        Style="{StaticResource GoldCircularCheckBoxStyle}" 
                                        Checked="Filters_Changed" 
                                        Unchecked="Filters_Changed"/>
                            </StackPanel>
                        </Grid>

                        <ListBox x:Name="LstPets" Grid.Row="2" Background="#1A1A24" BorderBrush="#333" Foreground="White" SelectionChanged="LstPets_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="VerticalContentAlignment" Value="Top"/>
                                    <Setter Property="Padding" Value="0"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="5">
                                        <Image Source="{Binding Thumbnail}" Width="40" Height="40" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="White" TextWrapping="Wrap"/>
                                        <Ellipse Width="10" Height="10" Fill="Lime" Margin="10,0,0,0" Visibility="{Binding VisibilityIndicator}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <Border Grid.Column="1" Background="#1A1A24" CornerRadius="10" Padding="15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> 
                                <RowDefinition Height="*"/>    
                                <RowDefinition Height="Auto"/> 
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="TxtSelectedPetName" Grid.Row="0" Text="None selected" FontWeight="Bold" TextAlignment="Center" Margin="0,0,0,10" Foreground="White"/>
                            <Border Grid.Row="1" Background="Black" Margin="0,0,0,15">
                                <Grid>
                                    <TextBlock x:Name="TxtEmptyPetPreview" Text="No preview" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="Gray"/>
                                    <Image x:Name="ImgPetPreview" Stretch="Uniform"/>
                                </Grid>
                            </Border>
                            
                            <StackPanel x:Name="ActionButtonsPanel" Grid.Row="2" VerticalAlignment="Bottom" Visibility="Collapsed">
                                <StackPanel.Resources>
                                    
                                    <Style x:Key="BaseRoundedBtn" TargetType="Button">
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Height" Value="38"/>
                                        <Setter Property="Margin" Value="0,0,0,8"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Opacity" Value="0.8"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>

                                    <Style x:Key="BtnLaunchStyle" BasedOn="{StaticResource BaseRoundedBtn}" TargetType="Button">
                                        <Setter Property="Background" Value="#6366F1"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#818CF8"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>

                                    <Style x:Key="BtnCloseStyle" BasedOn="{StaticResource BaseRoundedBtn}" TargetType="Button">
                                        <Setter Property="Background" Value="#D97706"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#F59E0B"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>

                                    <Style x:Key="BtnDeleteStyle" BasedOn="{StaticResource BaseRoundedBtn}" TargetType="Button">
                                        <Setter Property="Background" Value="#EF4444"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#F87171"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                    
                                </StackPanel.Resources>

                                <Button Content="Launch Pet" 
                                        Style="{StaticResource BtnLaunchStyle}"
                                        Click="BtnLaunchPet_Click"/>
                                        
                                <Button Content="Close Active Pet" 
                                        Style="{StaticResource BtnCloseStyle}"
                                        Click="BtnClosePet_Click" 
                                        Visibility="{Binding SelectedItem.IsActive, ElementName=LstPets, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"/>
                                        
                                <Button Content="Delete" 
                                        Style="{StaticResource BtnDeleteStyle}"
                                        Click="BtnDeletePet_Click" 
                                        Margin="0"/>
                                        
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Create Pet">
                <Grid Margin="20">
                    <Grid.Resources>
                        <SolidColorBrush x:Key="CreateButtonBg" Color="#252538"/>
                        
                        <Style TargetType="Button" x:Key="AnimatedCreateButton">
                        </Style>

                       <Style TargetType="Button" x:Key="IconLeftButtonStyle">
                            <Setter Property="Background" Value="{StaticResource CreateButtonBg}"/> 
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="BorderBrush" Value="#333"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Margin" Value="10"/>
                            <Setter Property="Padding" Value="15,10"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border" 
                                                Background="{TemplateBinding Background}" 
                                                BorderBrush="{TemplateBinding BorderBrush}" 
                                                BorderThickness="{TemplateBinding BorderThickness}" 
                                                CornerRadius="10"
                                                Padding="{TemplateBinding Padding}"
                                                RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                                            </Border.RenderTransform>
                                            
                                            <Grid HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="20,10,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <Viewbox Grid.Column="0" Margin="0,0,20,0" Stretch="Uniform" MaxHeight="112" MaxWidth="112" HorizontalAlignment="Left">
                                                    <Border Width="112" Height="112" Background="Transparent">
                                                        <Image x:Name="iconImage" 
                                                            Source="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" 
                                                            Width="112" Height="112" Stretch="Uniform" 
                                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            RenderTransformOrigin="0.5,0.5">
                                                            <Image.RenderTransform>
                                                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                            </Image.RenderTransform>
                                                        </Image>
                                                    </Border>
                                                </Viewbox>

                                                <TextBlock x:Name="buttonText" 
                                                        Grid.Column="1"
                                                        Text="{TemplateBinding Content}" 
                                                        FontSize="22" FontWeight="Bold" 
                                                        Foreground="{TemplateBinding Foreground}" 
                                                        VerticalAlignment="Center"
                                                        TextWrapping="Wrap"
                                                        RenderTransformOrigin="0.5,0.5">
                                                    <TextBlock.RenderTransform>
                                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                    </TextBlock.RenderTransform>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                        
                                        <ControlTemplate.Triggers>
                                            <EventTrigger RoutedEvent="MouseEnter">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <ColorAnimation Storyboard.TargetName="border" 
                                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" 
                                                                        To="#2C2C3A" Duration="0:0:0.15"/>
                                                        <DoubleAnimation Storyboard.TargetName="border" 
                                                                        Storyboard.TargetProperty="RenderTransform.ScaleX" 
                                                                        To="1.02" Duration="0:0:0.15"/>
                                                        <DoubleAnimation Storyboard.TargetName="border" 
                                                                        Storyboard.TargetProperty="RenderTransform.ScaleY" 
                                                                        To="1.02" Duration="0:0:0.15"/>
                                                        
                                                        <DoubleAnimation Storyboard.TargetName="iconImage" 
                                                                        Storyboard.TargetProperty="RenderTransform.ScaleX" 
                                                                        To="1.15" Duration="0:0:0.15"/>
                                                        <DoubleAnimation Storyboard.TargetName="iconImage" 
                                                                        Storyboard.TargetProperty="RenderTransform.ScaleY" 
                                                                        To="1.15" Duration="0:0:0.15"/>

                                                        <DoubleAnimation Storyboard.TargetName="buttonText" 
                                                                        Storyboard.TargetProperty="RenderTransform.ScaleX" 
                                                                        To="1.05" Duration="0:0:0.15"/>
                                                        <DoubleAnimation Storyboard.TargetName="buttonText" 
                                                                        Storyboard.TargetProperty="RenderTransform.ScaleY" 
                                                                        To="1.05" Duration="0:0:0.15"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                            <EventTrigger RoutedEvent="MouseLeave">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <ColorAnimation Storyboard.TargetName="border" 
                                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" 
                                                                        To="#252538" Duration="0:0:0.2"/>
                                                        <DoubleAnimation Storyboard.TargetName="border" 
                                                                        Storyboard.TargetProperty="RenderTransform.ScaleX" 
                                                                        To="1" Duration="0:0:0.2"/>
                                                        <DoubleAnimation Storyboard.TargetName="border" 
                                                                        Storyboard.TargetProperty="RenderTransform.ScaleY" 
                                                                        To="1" Duration="0:0:0.2"/>
                                                        
                                                        <DoubleAnimation Storyboard.TargetName="iconImage" 
                                                                        Storyboard.TargetProperty="RenderTransform.ScaleX" 
                                                                        To="1" Duration="0:0:0.2"/>
                                                        <DoubleAnimation Storyboard.TargetName="iconImage" 
                                                                        Storyboard.TargetProperty="RenderTransform.ScaleY" 
                                                                        To="1" Duration="0:0:0.2"/>

                                                        <DoubleAnimation Storyboard.TargetName="buttonText" 
                                                                        Storyboard.TargetProperty="RenderTransform.ScaleX" 
                                                                        To="1" Duration="0:0:0.2"/>
                                                        <DoubleAnimation Storyboard.TargetName="buttonText" 
                                                                        Storyboard.TargetProperty="RenderTransform.ScaleY" 
                                                                        To="1" Duration="0:0:0.2"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Grid.Resources>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BtnOpenPetCreator" Click="BtnOpenPetCreator_Click" 
                            Content="Create Smart Pet" 
                            Tag="pack://application:,,,/Assets/Buttons/btn_create_SP.png"
                            Grid.Row="0" Grid.Column="0" 
                            Style="{StaticResource IconLeftButtonStyle}"/>

                    <Button x:Name="BtnEditPetCreator" Click="BtnEditPetCreator_Click" 
                            Content="Edit Smart Pet" 
                            Tag="pack://application:,,,/Assets/Buttons/btn_edit_SP.png"
                            Grid.Row="0" Grid.Column="1" 
                            Style="{StaticResource IconLeftButtonStyle}"/>

                    <Button x:Name="BtnCreateGifPackage" Click="BtnCreateGifPackage_Click" 
                            Content="Create New GIF Package (.vpet)" 
                            Tag="pack://application:,,,/Assets/Buttons/btn_create_GIFP.png"
                            Grid.Row="1" Grid.Column="0" 
                            Style="{StaticResource IconLeftButtonStyle}"/>
                            
                    <Button x:Name="BtnEditGifPackage" Click="BtnEditGifPackage_Click" 
                            Content="Edit GIF Package (.vpet)" 
                            Tag="pack://application:,,,/Assets/Buttons/btn_edit_GIFP.png"
                            Grid.Row="1" Grid.Column="1" 
                            Style="{StaticResource IconLeftButtonStyle}"/>   

                </Grid>
            </TabItem>

            <TabItem Header="Tools">
                <Grid Margin="20">
                    <Grid.Resources>
                        <SolidColorBrush x:Key="ButtonBackground" Color="#1A1A24"/>
                        <Style TargetType="Button" x:Key="AnimatedToolButton">
                            <Setter Property="Background" Value="{StaticResource ButtonBackground}"/> 
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="BorderBrush" Value="#333"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Margin" Value="10"/> 
                            <Setter Property="Padding" Value="15,10"/> 
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border" 
                                                Background="{TemplateBinding Background}" 
                                                BorderBrush="{TemplateBinding BorderBrush}" 
                                                BorderThickness="{TemplateBinding BorderThickness}" 
                                                CornerRadius="10"
                                                Padding="{TemplateBinding Padding}"
                                                RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                                            </Border.RenderTransform>
                                            
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10">
                                                <Border Width="84" Height="84" Background="Transparent" Margin="0,0,0,10">
                                                    <Image x:Name="iconImage" 
                                                        Source="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" 
                                                        Width="84" Height="84" Stretch="Uniform" 
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        RenderTransformOrigin="0.5,0.5">
                                                        <Image.RenderTransform>
                                                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                        </Image.RenderTransform>
                                                    </Image>
                                                </Border>

                                                <TextBlock x:Name="buttonText" 
                                                        Text="{TemplateBinding Content}" 
                                                        FontSize="22" FontWeight="Bold" 
                                                        Foreground="{TemplateBinding Foreground}" 
                                                        HorizontalAlignment="Center"
                                                        TextAlignment="Center"
                                                        TextWrapping="Wrap"
                                                        RenderTransformOrigin="0.5,0.5">
                                                    <TextBlock.RenderTransform>
                                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                    </TextBlock.RenderTransform>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                        
                                        <ControlTemplate.Triggers>
                                            <EventTrigger RoutedEvent="MouseEnter">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <ColorAnimation Storyboard.TargetName="border" 
                                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" 
                                                                        To="#2C2C3A" Duration="0:0:0.15"/>
                                                        <DoubleAnimation Storyboard.TargetName="border" 
                                                                        Storyboard.TargetProperty="RenderTransform.ScaleX" 
                                                                        To="1.02" Duration="0:0:0.15"/>
                                                        <DoubleAnimation Storyboard.TargetName="border" 
                                                                        Storyboard.TargetProperty="RenderTransform.ScaleY" 
                                                                        To="1.02" Duration="0:0:0.15"/>
                                                        
                                                        <DoubleAnimation Storyboard.TargetName="iconImage" 
                                                                        Storyboard.TargetProperty="RenderTransform.ScaleX" 
                                                                        To="1.15" Duration="0:0:0.15"/>
                                                        <DoubleAnimation Storyboard.TargetName="iconImage" 
                                                                        Storyboard.TargetProperty="RenderTransform.ScaleY" 
                                                                        To="1.15" Duration="0:0:0.15"/>

                                                        <DoubleAnimation Storyboard.TargetName="buttonText" 
                                                                        Storyboard.TargetProperty="RenderTransform.ScaleX" 
                                                                        To="1.05" Duration="0:0:0.15"/>
                                                        <DoubleAnimation Storyboard.TargetName="buttonText" 
                                                                        Storyboard.TargetProperty="RenderTransform.ScaleY" 
                                                                        To="1.05" Duration="0:0:0.15"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                            <EventTrigger RoutedEvent="MouseLeave">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <ColorAnimation Storyboard.TargetName="border" 
                                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" 
                                                                        To="#1A1A24" Duration="0:0:0.2"/>
                                                        <DoubleAnimation Storyboard.TargetName="border" 
                                                                        Storyboard.TargetProperty="RenderTransform.ScaleX" 
                                                                        To="1" Duration="0:0:0.2"/>
                                                        <DoubleAnimation Storyboard.TargetName="border" 
                                                                        Storyboard.TargetProperty="RenderTransform.ScaleY" 
                                                                        To="1" Duration="0:0:0.2"/>
                                                        
                                                        <DoubleAnimation Storyboard.TargetName="iconImage" 
                                                                        Storyboard.TargetProperty="RenderTransform.ScaleX" 
                                                                        To="1" Duration="0:0:0.2"/>
                                                        <DoubleAnimation Storyboard.TargetName="iconImage" 
                                                                        Storyboard.TargetProperty="RenderTransform.ScaleY" 
                                                                        To="1" Duration="0:0:0.2"/>

                                                        <DoubleAnimation Storyboard.TargetName="buttonText" 
                                                                        Storyboard.TargetProperty="RenderTransform.ScaleX" 
                                                                        To="1" Duration="0:0:0.2"/>
                                                        <DoubleAnimation Storyboard.TargetName="buttonText" 
                                                                        Storyboard.TargetProperty="RenderTransform.ScaleY" 
                                                                        To="1" Duration="0:0:0.2"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Grid.Resources>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <UniformGrid Columns="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                                     MinHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                            
                            <Button Style="{StaticResource AnimatedToolButton}" 
                                    Content="GIF Creator" 
                                    Tag="pack://application:,,,/Assets/Buttons/btn_GIF_Creator.png" 
                                    Click="BtnToolsGenerateGif_Click"/>
                                    
                            <Button Style="{StaticResource AnimatedToolButton}" 
                                    Content="Image Font Remover" 
                                    Tag="pack://application:,,,/Assets/Buttons/btn_ImageR.png" 
                                    Click="BtnLaunchBgRemover_Click"/>

                            <Button Style="{StaticResource AnimatedToolButton}" 
                                    Content="GIF Background Remover" 
                                    Tag="pack://application:,,,/Assets/Buttons/btn_GIF_BGR.png" 
                                    Click="BtnLaunchGifRemover_Click"/>

                            <Button Style="{StaticResource AnimatedToolButton}" 
                                    Content="Sprite Sheet to GIF" 
                                    Tag="pack://application:,,,/Assets/Buttons/btn_SpriteS.png" 
                                    Click="BtnLaunchSpriteExtractor_Click"/>

                            <Button Style="{StaticResource AnimatedToolButton}" 
                                    Content="Video Bg Remover" 
                                    Tag="pack://application:,,,/Assets/Buttons/VideoBgRemoverIcon.png" 
                                    Click="BtnLaunchVideoBgRemover_Click"/>

                            <Button Style="{StaticResource AnimatedToolButton}" 
                                    Content="Audio Format Converter" 
                                    Tag="pack://application:,,,/Assets/Buttons/AudioConverterIcon.png" 
                                    Click="BtnLaunchAudioConverter_Click"/>

                            <Button Style="{StaticResource AnimatedToolButton}" 
                                    Content="GIF Frame Extractor" 
                                    Tag="pack://application:,,,/Assets/Buttons/FrameExtractorIcon.png" 
                                    Click="BtnLaunchFrameExtractor_Click"/>

                            <Button Style="{StaticResource AnimatedToolButton}" 
                                    Content="Sprite Sheet Unpacker" 
                                    Tag="pack://application:,,,/Assets/Buttons/SpriteUnpackerIcon.png" 
                                    Click="BtnLaunchSpriteTools_Click"/>

                            <Button Style="{StaticResource AnimatedToolButton}" 
                                    Content="Sprite Sheet Packer" 
                                    Tag="pack://application:,,,/Assets/Buttons/SpritePackerIcon.png" 
                                    Click="BtnLaunchSpritePacker_Click"/>

                        </UniformGrid>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#1A1A24">
                    <StackPanel Margin="20,15,20,20" HorizontalAlignment="Stretch">
                        
                        <Border Background="#252538" CornerRadius="8" Padding="20" Margin="0,0,0,20" BorderBrush="#333" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="GENERAL" FontSize="16" FontWeight="Bold" Foreground="#4A90E2" Margin="0,0,0,15" />
                                
                                <TextBlock Text="Startup" FontWeight="SemiBold" Foreground="#DDD" Margin="0,0,0,8"/>
                                <CheckBox x:Name="ChkRunOnStartup" Content="Start program when computer starts" Foreground="White" Margin="0,0,0,4" 
                                        Checked="ChkRunOnStartup_Checked" Unchecked="ChkRunOnStartup_Unchecked"/>
                                <TextBlock Text="Toggle whether VirtualPeto opens automatically on Windows sign in." 
                                        Foreground="#AAAAAA" TextWrapping="Wrap" Margin="20,0,0,20" FontSize="11"/>
                                <CheckBox x:Name="ChkStartFavorites" Content="Start favorite pets on launch" Foreground="White" Margin="0,0,0,4" 
                                        Checked="ChkStartFavorites_Checked" Unchecked="ChkStartFavorites_Unchecked"/>
                                <TextBlock Text="Automatically start pets marked as favorites when the program opens." 
                                        Foreground="#AAAAAA" TextWrapping="Wrap" Margin="20,0,0,20" FontSize="11"/>
                                
                                <TextBlock Text="Memory &amp; Cache" FontWeight="SemiBold" Foreground="#DDD" Margin="0,0,0,8"/>
                                <Button Content="Clear cache now" Click="BtnClearCache_Click" Padding="15,6" Background="#22222E" 
                                        Foreground="White" BorderBrush="#CCCCCC" BorderThickness="1" Cursor="Hand" HorizontalAlignment="Left" Margin="0,0,0,10"/>
                                <CheckBox x:Name="ChkAutoClearCache" Content="Clear cache automatically when windows close" Foreground="White" Margin="0,0,0,4" 
                                        Checked="ChkAutoClearCache_Checked" Unchecked="ChkAutoClearCache_Unchecked"/>
                                <TextBlock Text="When enabled, the app releases loaded images and media when pet windows are closed." 
                                        Foreground="#AAAAAA" TextWrapping="Wrap" Margin="20,0,0,5" FontSize="11"/>
                                <TextBlock Text="Default folder to save files:" Foreground="#CCCCCC" FontSize="14" Margin="0,0,0,5"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/> 
                                        <ColumnDefinition Width="Auto"/> 
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtDefaultFolder" Grid.Column="0" IsReadOnly="True" 
                                            Text="C:\Ruta\Por\Defecto" 
                                            Background="#1E1E28" Foreground="White" BorderBrush="#555566" BorderThickness="1" 
                                            Padding="5" Margin="0,0,10,0" VerticalContentAlignment="Center"/>
                                    <Button Grid.Column="1" Content="Browse..." Click="BtnBrowseFolder_Click" 
                                            Padding="15,6" Background="#22222E" Foreground="White" 
                                            BorderBrush="#CCCCCC" BorderThickness="1" Cursor="Hand"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="#252538" CornerRadius="8" Padding="20" Margin="0,0,0,10" BorderBrush="#333" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="PETS" FontSize="16" FontWeight="Bold" Foreground="#4A90E2" Margin="0,0,0,15"/>
                                
                                <TextBlock Text="Behavior &amp; Display" FontWeight="SemiBold" Foreground="#DDD" Margin="0,0,0,10"/>
                                <CheckBox x:Name="ChkOverlapping" Content="Allow pets to overlay on full screen apps." Foreground="White" Margin="0,0,0,10" 
                                        Checked="ChkOverlapping_Checked" Unchecked="ChkOverlapping_Unchecked"/>
                                <CheckBox x:Name="ChkLockPet" Content="Block pet position (Clicks will pass through)" Foreground="White" Margin="0,0,0,10" 
                                        Checked="ChkLockPet_Checked" Unchecked="ChkLockPet_Unchecked"/>
                                
                                <CheckBox x:Name="ChkPlaySounds" Content="Allow pets to play sounds" Foreground="White" Margin="0,0,0,10" 
                                        Checked="ChkPlaySounds_Checked" Unchecked="ChkPlaySounds_Unchecked"/>
                                <CheckBox x:Name="ChkSecondMonitor" Content="Allow pets to react to the second monitor" Foreground="White" Margin="0,0,0,25" 
                                        Checked="ChkSecondMonitor_Checked" Unchecked="ChkSecondMonitor_Unchecked"/>

                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Desktop pet limit:" Foreground="White" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button x:Name="BtnDecreasePetLimit" Content="-" Width="35" Height="30" Click="BtnDecreasePetLimit_Click" Background="#2C2C3A" Foreground="White" BorderBrush="#CCCCCC" BorderThickness="1" Cursor="Hand"/>
                                        <TextBlock x:Name="TxtPetLimit" Text="5" Width="45" TextAlignment="Center" VerticalAlignment="Center" Foreground="White" FontSize="14" FontWeight="Bold" Margin="5,0"/>
                                        <Button x:Name="BtnIncreasePetLimit" Content="+" Width="35" Height="30" Click="BtnIncreasePetLimit_Click" Background="#2C2C3A" Foreground="White" BorderBrush="#CCCCCC" BorderThickness="1" Cursor="Hand"/>
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Time before sleep (minutes):" Foreground="White" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button x:Name="BtnDecreaseSleep" Content="-" Width="35" Height="30" Click="BtnDecreaseSleep_Click" Background="#2C2C3A" Foreground="White" BorderBrush="#CCCCCC" BorderThickness="1" Cursor="Hand"/>
                                        <TextBlock x:Name="TxtSleepTime" Text="15" Width="45" TextAlignment="Center" VerticalAlignment="Center" Foreground="White" FontSize="14" FontWeight="Bold" Margin="5,0"/>
                                        <Button x:Name="BtnIncreaseSleep" Content="+" Width="35" Height="30" Click="BtnIncreaseSleep_Click" Background="#2C2C3A" Foreground="White" BorderBrush="#CCCCCC" BorderThickness="1" Cursor="Hand"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Set to 0 to disable sleep mode." Foreground="#AAAAAA" FontSize="11" Margin="220,5,0,0"/>

                                <Separator Margin="0,20,0,15" Background="#333"/>
                                <TextBlock Text="Jukebox" FontWeight="SemiBold" Foreground="#DDD" Margin="0,0,0,8"/>
                                <TextBlock Text="Music folder for Jukebox:" Foreground="#CCCCCC" FontSize="13" Margin="0,0,0,5"/>
                                <TextBlock Text="When a pet spawns a Jukebox, it will automatically pick a random song from this folder." 
                                           Foreground="#AAAAAA" TextWrapping="Wrap" Margin="0,0,0,8" FontSize="11"/>
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtJukeboxMusicFolder" Grid.Column="0" IsReadOnly="True"
                                             Background="#1E1E28" Foreground="White" BorderBrush="#555566" BorderThickness="1"
                                             Padding="5" Margin="0,0,10,0" VerticalContentAlignment="Center"/>
                                    <Button Grid.Column="1" Content="Browse..." Click="BtnBrowseJukeboxFolder_Click"
                                            Padding="15,6" Background="#22222E" Foreground="White"
                                            BorderBrush="#CCCCCC" BorderThickness="1" Cursor="Hand"/>
                                </Grid>
                                <TextBlock Text="Supported formats: .mp3 .wav .m4a .wma" Foreground="#AAAAAA" FontSize="11"/>

                            </StackPanel>
                        </Border>

                        <Border Background="#252538" CornerRadius="8" Padding="20" Margin="0,0,0,10" BorderBrush="#333" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="CREDITS" FontSize="16" FontWeight="Bold" Foreground="#4A90E2" Margin="0,0,0,15"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="TrueEuphoria" Foreground="#AAA" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    
                                    <Button Click="BtnOpenItch_Click" Background="#2C2C3A" Foreground="White" BorderThickness="0" Padding="8,3" Margin="0,0,6,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image Source="/Assets/itch_io_logo_icon.png" Width="14" Height="14" Margin="0,0,5,0" Stretch="Uniform"/>
                                            <TextBlock Text="itch.io" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Click="BtnOpenKofi_Click" Background="#2C2C3A" Foreground="White" BorderThickness="0" Padding="8,3" Margin="0,0,6,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image Source="/Assets/ko_fi_logo_icon.png" Width="14" Height="14" Margin="0,0,5,0" Stretch="Uniform"/>
                                            <TextBlock Text="Ko-fi" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Click="BtnOpenDiscord_Click" Background="#2C2C3A" Foreground="White" BorderThickness="0" Padding="8,3" Margin="0,0,6,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image Source="/Assets/discord_logo_icon.png" Width="14" Height="14" Margin="0,0,5,0" Stretch="Uniform"/>
                                            <TextBlock Text="Discord" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    
                                    <TextBlock Text="v2.2.5-beta" Foreground="#AAA" VerticalAlignment="Center" Margin="15,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
</Window>