<Window x:Class="VirtualPeto.Objects.FoodCreatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Food Creator" Height="550" Width="450"
        Background="#1E1E2E" WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10,0,5"/>
        </Style>
        
        <Style TargetType="Button" x:Key="ActionBtn">
            <Setter Property="Background" Value="#4A90E2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="10,20,10,0"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="#1A1A24"/>
            <Setter Property="BorderBrush" Value="#3A3A4A"/>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1A1A24"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#3A3A4A"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#4A90E2"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Padding="20">
        <StackPanel>
            <TextBlock Text="CREATE NEW FOOD" FontSize="22" Foreground="#4A90E2" 
                       HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock Text="Food Name:"/>
            <TextBox x:Name="TxtFoodName" FontSize="14" Padding="5" 
                     Background="#252538" Foreground="White" BorderBrush="#333"/>

            <TextBlock Text="Food Image:"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtImagePath" Grid.Column="0" FontSize="14" Padding="5" 
                         Background="#252538" Foreground="White" BorderBrush="#333" IsReadOnly="True"/>
                <Button x:Name="BtnBrowseImage" Grid.Column="1" Content="Browse..." 
                        Click="BtnBrowseImage_Click" Margin="10,0,0,0" Padding="10,5"
                        Background="#333" Foreground="White" BorderThickness="0"/>
            </Grid>

            <TextBlock Text="{Binding ElementName=SliderHunger, Path=Value, StringFormat='Restores Hunger: {0}'}"/>
            <Slider x:Name="SliderHunger" Minimum="0" Maximum="100" Value="20" TickFrequency="5" IsSnapToTickEnabled="True"/>

            <TextBlock Text="{Binding ElementName=SliderHealth, Path=Value, StringFormat='Health Impact: {0}'}"/>
            <Slider x:Name="SliderHealth" Minimum="-50" Maximum="50" Value="0" TickFrequency="5" IsSnapToTickEnabled="True"/>

            <TextBlock Text="{Binding ElementName=SliderEnergy, Path=Value, StringFormat='Energy Impact: {0}'}"/>
            <Slider x:Name="SliderEnergy" Minimum="-50" Maximum="50" Value="10" TickFrequency="5" IsSnapToTickEnabled="True"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button x:Name="BtnSave" Content="SAVE FOOD" Style="{StaticResource ActionBtn}" Click="BtnSave_Click"/>
                <Button x:Name="BtnCancel" Content="CANCEL" Style="{StaticResource ActionBtn}" Background="#D32F2F" Click="BtnCancel_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>