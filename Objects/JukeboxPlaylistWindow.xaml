<Window x:Class="VirtualPeto.Objects.JukeboxPlaylistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jukebox Player" Height="430" Width="460"
        Background="#1A1A24"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        KeyDown="Window_KeyDown">
    <Border Margin="10" Padding="12" Background="#1F1F2A" BorderBrush="#5A5A70" BorderThickness="1" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="TxtCurrentSong" Grid.Row="0" Text="No track selected" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" TextTrimming="CharacterEllipsis"/>

            <Border Grid.Row="1" Background="#09090D" BorderBrush="#52586A" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,10">
                <ListBox x:Name="SongsList" Background="#191920" Foreground="White" BorderThickness="0" SelectionChanged="SongsList_SelectionChanged"/>
            </Border>

            <TextBlock x:Name="TxtStatus" Grid.Row="2" Text="Ready" Foreground="#B4B4C8" FontSize="12" Margin="0,0,0,8"/>

            <Grid Grid.Row="3" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BtnPrev" Grid.Column="0" Content="Prev" Click="BtnPrev_Click" Padding="10,6" Margin="0,0,8,0" Background="#2C2C3A" Foreground="White" BorderBrush="#808098" BorderThickness="1"/>
                <Button x:Name="BtnPlayPause" Grid.Column="1" Content="Play" Click="BtnPlayPause_Click" Padding="18,7" Margin="0,0,8,0" Background="#4964D2" Foreground="White" BorderThickness="0"/>
                <Button x:Name="BtnNext" Grid.Column="2" Content="Next" Click="BtnNext_Click" Padding="10,6" Margin="0,0,8,0" Background="#2C2C3A" Foreground="White" BorderBrush="#808098" BorderThickness="1"/>
                <Button x:Name="BtnMute" Grid.Column="3" Content="Mute" Click="BtnMute_Click" Padding="10,6" Background="#2C2C3A" Foreground="White" BorderBrush="#808098" BorderThickness="1"/>
            </Grid>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtVolume" Grid.Column="0" Text="Volume: 50%" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Slider x:Name="SldVolume" Grid.Column="1" Minimum="0" Maximum="1" Value="0.5" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="SldVolume_ValueChanged"/>
            </Grid>
        </Grid>
    </Border>
</Window>
